generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id        String     @id @default(cuid())
  name      String
  phone     String     @unique
  password  String
  examId    String
  exam      Quiz       @relation(fields: [examId], references: [id])
  /** AWAITING_PROOF | PENDING_REVIEW | APPROVED | REJECTED */
  subscriptionStatus String   @default("AWAITING_PROOF")
  /** Base64 data URI of the candidate's payment screenshot. Null until
   * they submit one from the payment page. */
  paymentScreenshot  String?
  /** Set by the admin when rejecting a payment proof; shown to the
   * candidate alongside the re-upload form. */
  rejectionReason    String?
  createdAt DateTime   @default(now())
  attempts  Attempt[]
}

/** An administrator account for the admin panel. Declared here too (even
 * though this app never reads/writes it) purely so `prisma db push` from
 * this repo never drops the table — db push deletes anything not declared
 * in the schema it's given, so both apps must always declare every model
 * that exists in the shared database. */
model AdminUser {
  id        String   @id @default(cuid())
  name      String   @unique
  password  String
  /** SUPER_ADMIN | EDITOR | VIEWER */
  role      String   @default("EDITOR")
  createdAt DateTime @default(now())
}

/** A payment channel (mobile money operator, bank transfer...) the admin
 * configures so candidates know where to send their subscription fee. */
model PaymentChannel {
  id        String   @id @default(cuid())
  name      String
  phone     String
  /** Base64 data URI of an uploaded logo/icon. Null falls back to a
   * generated colored initials badge on both sites. */
  logo      String?
  order     Int      @default(0)
  createdAt DateTime @default(now())
}

model Quiz {
  id                 String            @id @default(cuid())
  slug               String            @unique
  ministere          String
  ministereFr        String
  ministereAr        String
  corpsFr            String
  corpsAr            String
  titleFr            String
  titleAr            String
  descriptionFr      String
  descriptionAr      String
  /** How many questions are randomly drawn from the pool for one attempt.
   * If the pool has fewer questions than this, every question is used. */
  questionsPerAttempt Int              @default(20)
  attempts           Attempt[]
  generationBatches  GenerationBatch[]
  candidates         User[]
  versions           QuizVersion[]
}

/** A permanent, independent set of questions for a Quiz. Each admin upload
 * (AI-generate or Excel-import) either creates a new version or appends to
 * an existing one; versions are never merged or overwritten. Candidates
 * pick which version to attempt. */
model QuizVersion {
  id                  String            @id @default(cuid())
  quizId              String
  quiz                Quiz              @relation(fields: [quizId], references: [id])
  /** 1, 2, 3... independent per quiz. */
  versionNumber       Int               @default(1)
  questionsPerAttempt Int               @default(20)
  archived            Boolean           @default(false)
  createdAt           DateTime          @default(now())
  questions           Question[]
  attempts            Attempt[]
  generationBatches   GenerationBatch[]

  @@unique([quizId, versionNumber])
}

model Question {
  id            String      @id @default(cuid())
  quizVersionId String
  quizVersion   QuizVersion @relation(fields: [quizVersionId], references: [id])
  textFr        String
  textAr        String
  choicesFr     String
  choicesAr     String
  correctIndices String
  explanationFr String @default("")
  explanationAr String @default("")
  order         Int    @default(0)
}

model Attempt {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  quizId    String
  quiz      Quiz     @relation(fields: [quizId], references: [id])
  quizVersionId String
  quizVersion   QuizVersion @relation(fields: [quizVersionId], references: [id])
  score     Int
  total     Int
  answers   String
  createdAt DateTime @default(now())
}

/** A batch of AI-generated draft questions awaiting admin review before
 * being published into the live question pool of a quiz. */
model GenerationBatch {
  id            String   @id @default(cuid())
  quizId        String
  quiz          Quiz     @relation(fields: [quizId], references: [id])
  /** Null while PENDING means "publishing creates a brand-new version";
   * non-null means "publishing appends into this existing version". */
  quizVersionId String?
  quizVersion   QuizVersion? @relation(fields: [quizVersionId], references: [id])
  /** PENDING | PUBLISHED | DISCARDED */
  status        String   @default("PENDING")
  /** JSON array of source filenames (from source-exams/) used for this batch. */
  sourceFiles   String
  /** JSON array of draft question objects, same shape as Question's
   * bilingual fields, kept editable until published. */
  questionsJson String
  createdAt     DateTime @default(now())
}
